    { "when": { "south": "true" }, "apply": { "model": "aeronautics_fly_by_instruments:block/avionics_cable_south" } },
    { "when": { "west": "true" }, "apply": { "model": "aeronautics_fly_by_instruments:block/avionics_cable_west" } },
